includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 8
    paths:
        - app
        - bootstrap/providers.php
        - config
        - database
        - routes
    tmpDir: storage/framework/cache/phpstan
    ignoreErrors:
        # Fortify's TwoFactorAuthenticationFailed declares `@var \App\Models\User $user`, a class
        # this app doesn't have (users live in App\Domain\Identity\Models). The listener narrows
        # with instanceof, so the access is safe; the error is about Fortify's docblock.
        -
            identifier: class.notFound
            path: app/Domain/Identity/Listeners/RecordFailedTwoFactor.php
