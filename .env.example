# ─────────────────────────────────────────────────────────────────────────────
# TradeMax environment. Copy to .env (composer setup does this) and fill in.
# Never commit real values. Every external provider has a `fake` driver for
# local work and tests, so most keys can stay empty until go-live.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=TradeMax
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

# Demo seeders + "DEMO ENVIRONMENT" banner. Must be false in production.
APP_DEMO=false
# Keeps deposits disabled until licensing is confirmed (see docs/RUNBOOK.md).
PLATFORM_LIVE_MODE=false
# Timezone for admin reports (the daily finance email is sent at 07:00 here).
ADMIN_TIMEZONE=UTC

# ── Localisation ─────────────────────────────────────────────────────────────
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
SUPPORTED_LOCALES=en,fr,es,pt,ar,zh,ru,tr
# Default display currency for fiat estimates (any active ISO 4217 code).
DEFAULT_DISPLAY_FIAT=USD

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database (MySQL 8, InnoDB, strict mode) ──────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=trademax
DB_USERNAME=root
DB_PASSWORD=

# ── Cache, queue, session ────────────────────────────────────────────────────
# `database` works out of the box on Windows. Switch CACHE_STORE and
# QUEUE_CONNECTION to `redis` once Redis/Memurai is installed (required before
# Phase 7: order streams, locks, order book cache).
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Auto-logout after this many idle minutes (users); admins are fixed at 15.
IDLE_LOGOUT_MINUTES=30

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Realtime ─────────────────────────────────────────────────────────────────
# reverb, or a hosted Pusher-compatible service if the host can't run websockets.
BROADCAST_CONNECTION=log
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080

# ── Files (private disks: kyc, receipts, tickets) ────────────────────────────
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# Upload virus scanning: defender (Windows), clamav, or null.
VIRUS_SCAN_DRIVER=null

# ── Mail (Mailpit locally; SES or Resend in production) ─────────────────────
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Crypto payments (deposits) ───────────────────────────────────────────────
# nowpayments | coingate | fake
PAYMENT_GATEWAY=fake
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_SANDBOX=true
COINGATE_API_KEY=
COINGATE_SANDBOX=true

# Withdrawals: manual (finance broadcasts and pastes the tx hash) | gateway
PAYOUT_DRIVER=manual
WITHDRAW_AUTO_APPROVE_LIMIT_USD=1000
WITHDRAW_DUAL_APPROVAL_LIMIT_USD=25000

# On-chain verification for manual deposits
ETHERSCAN_API_KEY=
BSCSCAN_API_KEY=
TRONGRID_API_KEY=
BLOCKSTREAM_BASE_URL=https://blockstream.info/api

# Custody: manual | fireblocks | bitgo. The app never holds private keys.
CUSTODY_DRIVER=manual
# Fiat on-ramp widget (off by default): null | moonpay | transak | banxa
ONRAMP_DRIVER=null
LEDGER_RECONCILE_TOLERANCE_USD=1

# ── SMS / voice OTP ──────────────────────────────────────────────────────────
# failover tries the country route, then primary, then fallback. fake for local.
SMS_DRIVER=fake
SMS_PRIMARY=twilio
SMS_FALLBACK=vonage
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_VERIFY_SID=
VONAGE_KEY=
VONAGE_SECRET=

# ── KYC / identity ───────────────────────────────────────────────────────────
# sumsub | onfido | veriff | fake
KYC_DRIVER=fake
SUMSUB_APP_TOKEN=
SUMSUB_SECRET=
SUMSUB_WEBHOOK_SECRET=
ONFIDO_API_TOKEN=
ONFIDO_WEBHOOK_TOKEN=
VERIFF_API_KEY=
VERIFF_SHARED_SECRET=
KYC_RETENTION_YEARS=5

# ── Compliance ───────────────────────────────────────────────────────────────
# Travel Rule: null | notabene | sumsub
TRAVEL_RULE_DRIVER=null
TRAVEL_RULE_THRESHOLD_USD=1000
# Blockchain analytics: null | chainalysis | trm | elliptic
CHAIN_ANALYTICS_DRIVER=null
CHAIN_ANALYTICS_API_KEY=
# GeoLite2 database for IP geolocation (refreshed weekly)
MAXMIND_LICENSE_KEY=

# ── Push notifications ───────────────────────────────────────────────────────
PUSH_FCM_CREDENTIALS=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Market data ──────────────────────────────────────────────────────────────
PRICE_FEED=binance
PRICE_FEED_FALLBACK=coingecko
FX_DRIVER=openexchangerates
OPENEXCHANGERATES_APP_ID=

# ── Trading ──────────────────────────────────────────────────────────────────
# internal (user order book only) | market_maker (platform MM account on the ledger)
TRADING_LIQUIDITY_MODE=internal
TRADING_MAKER_FEE=0.001000
TRADING_TAKER_FEE=0.001000

# ── Security & monitoring ────────────────────────────────────────────────────
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
SENTRY_LARAVEL_DSN=
# Comma-separated IPs allowed to reach /admin (empty = no allowlist)
ADMIN_IP_ALLOWLIST=

VITE_APP_NAME="${APP_NAME}"
